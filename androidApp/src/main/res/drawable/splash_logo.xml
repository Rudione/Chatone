<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="logo"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:name="arc"
                    android:pathData="M71.69,36.91A24.6,24.6 0 1 0 71.69,71.09"
                    android:strokeWidth="10.85"
                    android:strokeLineCap="round"
                    android:trimPathEnd="1">
                    <aapt:attr name="android:strokeColor">
                        <gradient
                            android:endX="79.7"
                            android:endY="85.0"
                            android:startX="30.5"
                            android:startY="31.6"
                            android:type="linear">
                            <item
                                android:color="#D9A2FF"
                                android:offset="0" />
                            <item
                                android:color="#A063FF"
                                android:offset="0.38" />
                            <item
                                android:color="#6D3AF0"
                                android:offset="0.7" />
                            <item
                                android:color="#2B7FFF"
                                android:offset="1" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="arc">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="720"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="logo">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="720"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="-90"
                    android:valueTo="0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="720"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.86"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="720"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.86"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
