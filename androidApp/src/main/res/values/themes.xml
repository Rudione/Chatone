<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Chatone" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/chatone_background</item>
        <item name="android:colorBackground">@color/chatone_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Chatone.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/chatone_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">720</item>
        <item name="postSplashScreenTheme">@style/Theme.Chatone</item>
    </style>
</resources>
