CREATE TABLE ChannelFolderEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    color TEXT NOT NULL DEFAULT '#9146FF',
    sortOrder INTEGER NOT NULL DEFAULT 0,
    isExpanded INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL DEFAULT (strftime('%s', 'now') * 1000)
);

CREATE TABLE ChannelFolderMapping (
    channelId TEXT NOT NULL,
    folderId TEXT NOT NULL,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (channelId, folderId),
    FOREIGN KEY (channelId) REFERENCES ChannelEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (folderId) REFERENCES ChannelFolderEntity(id) ON DELETE CASCADE
);

-- Folder operations
insertFolder:
INSERT OR REPLACE INTO ChannelFolderEntity(id, name, color, sortOrder, isExpanded)
VALUES (?, ?, ?, ?, ?);

getAllFolders:
SELECT * FROM ChannelFolderEntity ORDER BY sortOrder ASC;

getFolderById:
SELECT * FROM ChannelFolderEntity WHERE id = ?;

updateFolderName:
UPDATE ChannelFolderEntity SET name = ? WHERE id = ?;

updateFolderColor:
UPDATE ChannelFolderEntity SET color = ? WHERE id = ?;

updateFolderExpanded:
UPDATE ChannelFolderEntity SET isExpanded = ? WHERE id = ?;

updateFolderOrder:
UPDATE ChannelFolderEntity SET sortOrder = ? WHERE id = ?;

deleteFolder:
DELETE FROM ChannelFolderEntity WHERE id = ?;

-- Mapping operations
addChannelToFolder:
INSERT OR REPLACE INTO ChannelFolderMapping(channelId, folderId, sortOrder)
VALUES (?, ?, ?);

removeChannelFromFolder:
DELETE FROM ChannelFolderMapping WHERE channelId = ? AND folderId = ?;

removeAllChannelsFromFolder:
DELETE FROM ChannelFolderMapping WHERE folderId = ?;

getChannelsInFolder:
SELECT ce.* FROM ChannelEntity ce
INNER JOIN ChannelFolderMapping cfm ON ce.id = cfm.channelId
WHERE cfm.folderId = ?
ORDER BY cfm.sortOrder ASC;

getFoldersForChannel:
SELECT cfe.* FROM ChannelFolderEntity cfe
INNER JOIN ChannelFolderMapping cfm ON cfe.id = cfm.folderId
WHERE cfm.channelId = ?;

getUnfolderedChannels:
SELECT ce.* FROM ChannelEntity ce
WHERE ce.id NOT IN (SELECT channelId FROM ChannelFolderMapping)
ORDER BY ce.lastJoinedAt DESC;

getChannelIdsInFolder:
SELECT channelId FROM ChannelFolderMapping WHERE folderId = ? ORDER BY sortOrder ASC;
