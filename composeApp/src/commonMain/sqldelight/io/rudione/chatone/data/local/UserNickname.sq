CREATE TABLE UserNicknameEntity (
    twitchUserId TEXT NOT NULL PRIMARY KEY,
    nickname TEXT NOT NULL DEFAULT '',
    updatedAt INTEGER NOT NULL DEFAULT 0
);

getNickname:
SELECT * FROM UserNicknameEntity WHERE twitchUserId = ?;

getAllNicknames:
SELECT * FROM UserNicknameEntity;

upsertNickname:
INSERT OR REPLACE INTO UserNicknameEntity (twitchUserId, nickname, updatedAt)
VALUES (?, ?, ?);

deleteNickname:
DELETE FROM UserNicknameEntity WHERE twitchUserId = ?;
