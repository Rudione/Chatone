CREATE TABLE MentionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    channelLogin TEXT NOT NULL,
    fromUsername TEXT NOT NULL,
    fromDisplayName TEXT NOT NULL,
    fromColor TEXT,
    text TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    isRead INTEGER NOT NULL DEFAULT 0
);

insertMention:
INSERT OR REPLACE INTO MentionEntity(id, channelLogin, fromUsername, fromDisplayName, fromColor, text, timestamp, isRead)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getMentions:
SELECT * FROM MentionEntity
ORDER BY timestamp DESC
LIMIT 200;

markAsRead:
UPDATE MentionEntity SET isRead = 1 WHERE id = ?;

markAllAsRead:
UPDATE MentionEntity SET isRead = 1;

deleteMentionsOlderThan:
DELETE FROM MentionEntity WHERE timestamp < ?;

countUnread:
SELECT COUNT(*) FROM MentionEntity WHERE isRead = 0;
